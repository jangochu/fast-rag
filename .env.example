# Copy to .env and edit if you want to override defaults.
# All values shown here are the defaults baked into fast_rag/config.py.

FAST_RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAST_RAG_LLM_MODEL=qwen2.5:7b
FAST_RAG_OLLAMA_URL=http://localhost:11434
FAST_RAG_CHUNK_SIZE=500
FAST_RAG_CHUNK_OVERLAP=50
FAST_RAG_TOP_K=4

# Optional: if huggingface.co is unreachable (e.g. inside mainland China),
# point HuggingFace downloads to a mirror. Read by huggingface_hub directly.
# HF_ENDPOINT=https://hf-mirror.com
