# Copy to .env and edit if you want to override defaults.
# All values shown here are the defaults baked into fast_rag/config.py.

# ---- Provider selector (LLM + Embedding switch together) ----
FAST_RAG_PROVIDER=ollama          # ollama | bailian

# ---- Ollama (local) ----
FAST_RAG_OLLAMA_LLM=qwen2.5:7b
FAST_RAG_OLLAMA_EMBED=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAST_RAG_OLLAMA_URL=http://localhost:11434

# ---- Bailian / DashScope (OpenAI-compatible) ----
# DASHSCOPE_API_KEY=sk-xxxx       # required when FAST_RAG_PROVIDER=bailian
FAST_RAG_BAILIAN_LLM=qwen-plus
FAST_RAG_BAILIAN_EMBED=text-embedding-v3
FAST_RAG_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Common ----
FAST_RAG_CHUNK_SIZE=500
FAST_RAG_CHUNK_OVERLAP=50
FAST_RAG_TOP_K=4

# Optional: if huggingface.co is unreachable (e.g. inside mainland China),
# point HuggingFace downloads to a mirror. Read by huggingface_hub directly.
# Only applies to the ollama provider (which uses HuggingFaceEmbeddings).
# HF_ENDPOINT=https://hf-mirror.com
